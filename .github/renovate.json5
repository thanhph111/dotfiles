// dotfiles is public, and Renovate does not let a public repository read a
// preset from a private one. So this config repeats the default preset in
// thanhph111/infrastructure, github/accounts/thanhph111/renovate/default.json5,
// and adds dotfiles' own managers and rules. Change both together.
{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices"
    ],
    "labels": [
        "dependencies"
    ],
    "minimumReleaseAge": "7 days",
    "internalChecksFilter": "strict",
    "prConcurrentLimit": 2,
    "major": {
        "dependencyDashboardApproval": true
    },
    "pre-commit": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Raise k3s one minor version at a time, after checking that Flux supports it, as the k3s guide says",
            "matchDepNames": [
                "k3s-io/k3s"
            ],
            "matchUpdateTypes": [
                "minor",
                "major"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Digests and lock files have no release timestamps, so a minimum age would hold them forever",
            "matchUpdateTypes": [
                "pinDigest",
                "digest",
                "lockFileMaintenance"
            ],
            "minimumReleaseAge": null
        },
        {
            "description": "GHCR images have no release timestamps either",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "/^ghcr\\.io\\//"
            ],
            "minimumReleaseAge": null
        },
        {
            "description": "Move the tools that check a repository together",
            "matchManagers": [
                "mise"
            ],
            "groupName": "project check tools"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "The k3s release that dotfiles installs",
            "managerFilePatterns": [
                "/^home/\\.chezmoidata/features\\.yaml$/"
            ],
            "matchStrings": [
                "k3s:\\s+enabled:\\s+\\w+\\s+version:\\s*(?<currentValue>v\\S+)"
            ],
            "depNameTemplate": "k3s-io/k3s",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
        },
        {
            "customType": "regex",
            "description": "The NVIDIA Container Toolkit packages that dotfiles pins, without their Debian revision",
            "managerFilePatterns": [
                "/^home/\\.chezmoidata/features\\.yaml$/"
            ],
            "matchStrings": [
                "nvidia_container_toolkit:\\s+enabled:\\s+\\w+\\s+package_version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)-\\d+"
            ],
            "depNameTemplate": "NVIDIA/nvidia-container-toolkit",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.+)$"
        },
        {
            "customType": "regex",
            "description": "dprint's own plugins, named in their URL",
            "managerFilePatterns": [
                "/(^|/)\\.?dprint\\.jsonc?$/"
            ],
            "matchStrings": [
                "https://plugins\\.dprint\\.dev/(?<depName>[a-z]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm"
            ],
            "packageNameTemplate": "dprint/dprint-plugin-{{{depName}}}",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "description": "Other authors' dprint plugins, named by their repository in the URL",
            "managerFilePatterns": [
                "/(^|/)\\.?dprint\\.jsonc?$/"
            ],
            "matchStrings": [
                "https://plugins\\.dprint\\.dev/(?<depName>[^/\"\\s]+/[^/\"\\s]+?)-(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\\.wasm"
            ],
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "description": "The hook repositories that prek runs",
            "managerFilePatterns": [
                "/(^|/)prek\\.toml$/"
            ],
            "matchStrings": [
                "repo = \"https://github\\.com/(?<depName>[^\"\\s]+)\"\\s+rev = \"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "github-tags"
        }
    ]
}
