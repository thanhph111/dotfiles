{{- if eq .codename "Grid" -}}
{{/* Invariant: bootstrap runs second apply only after op CLI + auth are ready. */}}
{{- $secretsEnabled := or (index . "secretsEnabled") (env "OP_SERVICE_ACCOUNT_TOKEN") (eq (env "CHEZMOI_ENABLE_SECRETS") "1") -}}
{{ if $secretsEnabled }}
{
    "apiKey": "{{ onepasswordRead "op://CLU/OpenClaw/credential" }}"
}
{{ else }}
{
    "apiKey": "MISSING_OP_CLI_RUN_SECOND_APPLY"
}
{{ end }}
{{- end -}}
