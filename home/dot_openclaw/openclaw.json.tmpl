{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $darwin := get $features "darwin" | default dict -}}
{{- $apps := get $darwin "apps" | default dict -}}
{{- $openclaw := get $apps "openclaw" | default dict -}}
{{- if and (eq .chezmoi.os "darwin") (get $machine "agent") (get $openclaw "enabled" | default false) -}}
{
    "apiKey": "MISSING_OP_CLI_RUN_SECOND_APPLY"
}
{{- end -}}
