#!/bin/sh

# POSIX login profile.
#
# Keep this file small.  It may be read by plain sh, Bash when no
# ~/.bash_profile exists, and other login-session launchers.  Interactive shell
# behavior belongs in ~/.bashrc or ~/.zshrc through shell/interactive.sh.

dotfiles_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
dotfiles_profile="$dotfiles_config_home/shell/profile.sh"
[ -r "$dotfiles_profile" ] || dotfiles_profile="$HOME/.config/shell/profile.sh"

if [ -r "$dotfiles_profile" ]; then
    DOTFILES_SHELL_ROOT="${dotfiles_profile%/*}"
    export DOTFILES_SHELL_ROOT
    # The entry file supports both XDG and fallback locations, so this path is
    # chosen at runtime.
    # shellcheck disable=SC1091
    # shellcheck source=dot_config/shell/profile.sh
    . "$dotfiles_profile"
fi
unset dotfiles_config_home dotfiles_profile
