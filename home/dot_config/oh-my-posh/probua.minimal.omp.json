{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "properties": {
                        "cache_duration": "none"
                    },
                    "template": "{{ .UserName }}@{{ .HostName }} ",
                    "foreground": "#ffdd86",
                    "type": "session",
                    "style": "plain"
                },
                {
                    "properties": {
                        "cache_duration": "none",
                        "style": "full"
                    },
                    "template": "{{ .Path }} ",
                    "foreground": "#42a9ff",
                    "type": "path",
                    "style": "plain"
                },
                {
                    "properties": {
                        "branch_icon": "",
                        "cache_duration": "none",
                        "fetch_status": true
                    },
                    "template": "git:{{ if or (.Working.Changed) (.Staging.Changed) (gt .StashCount 0) }}<#ffdd86>{{ .HEAD }}</>{{ else }}{{ .HEAD }}{{ end }}{{ if .Staging.Changed }} <#98c379>{{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }} <#d16971>{{ .Working.String }}</>{{ end }}",
                    "type": "git",
                    "style": "plain"
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "properties": {
                        "always_enabled": true,
                        "cache_duration": "none"
                    },
                    "template": "> ",
                    "foreground": "#ffdd86",
                    "type": "status",
                    "style": "plain",
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}#42a9ff{{ end }}"
                    ]
                }
            ],
            "newline": true
        }
    ],
    "version": 3
}
