$include /etc/inputrc

# Up and down arrows move through history
"\e[A": history-search-backward
"\e[B": history-search-forward
# Also for <Ctrl-p> and <Ctrl-n>
"\C-p":history-search-backward
"\C-n":history-search-forward

# Use arrow keys to move by characters
"\e[C": forward-char
"\e[D": backward-char

# Match completion candidates without caring about letter case.
set completion-ignore-case On

# Treat "-" and "_" as similar during case-insensitive completion.
set completion-map-case On

# Keep Tab predictable: complete the common prefix first, then show choices.
TAB: complete

# "\e[3~": backward-kill-word

# Clear current lines with `Esc`
# Escape: kill-whole-line

# `Ctrl` + `Backspace` to kill word
# "\C-h": backward-kill-word

# Colors and markers for completion lists.
set colored-stats On
set colored-completion-prefix On

# Keep the already-typed part short when Readline shows many choices.
set completion-prefix-display-length 3

set completion-query-items 200
set mark-symlinked-directories On
set show-all-if-ambiguous On
set show-all-if-unmodified On
set skip-completed-text On
set visible-stats On
set expand-tilde Off

# Do not run pasted text until Enter is pressed.  This protects against pasted
# commands that contain line breaks.
#
# For complex pasted commands, Ctrl-X Ctrl-E opens the current command line in
# $EDITOR so it can be reviewed before it runs.
set enable-bracketed-paste On
