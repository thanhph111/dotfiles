{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- if and (eq .chezmoi.os "linux") (not (get $machine "shared")) -}}
[Unit]
Description=Codex Remote Control
Documentation=https://learn.chatgpt.com/docs/developer-commands
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
# systemd owns the foreground process. Do not nest `codex remote-control start`,
# which starts a second daemon outside systemd's process lifecycle.
# Homebrew owns the Codex executable and uses this standard Linux prefix.
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:%h/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin
ExecStart=/home/linuxbrew/.linuxbrew/bin/codex remote-control
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
{{ end }}
