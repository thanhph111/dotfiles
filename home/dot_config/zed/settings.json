// Documentation: https://zed.dev/docs/configuring-zed
{
    "icon_theme": "Zed (Default)",
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-4o"
        }
    },
    "features": {
        "edit_prediction_provider": "zed"
    },
    "buffer_font_size": 13,
    "buffer_font_family": "Monaspace Neon",
    "ui_font_family": ".SystemUIFont",
    "ui_font_size": 16,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark Pro"
    },
    "terminal": {
        "font_family": "FiraCode Nerd Font",
        "font_size": 13,
        "font_weight": 500,
        "blinking": "on",
        "shell": {
            "with_arguments": {
                "program": "/bin/zsh",
                "args": [
                    "-is",
                    "exec unset HISTFILE"
                ]
            }
        },
        "env": {}
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "languages": {
        "Python": {
            "language_servers": [
                "ruff"
            ],
            "format_on_save": "on",
            "formatter": [
                {
                    "code_action": "source.organizeImports.ruff"
                },
                {
                    "code_action": "source.fixAll.ruff"
                },
                {
                    "language_server": {
                        "name": "ruff"
                    }
                }
            ]
        },
        "JSON": {
            "tab_size": 4
        },
        "JSONC": {
            "tab_size": 4
        }
    }
}
