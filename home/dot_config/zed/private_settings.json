// Documentation: https://zed.dev/docs/configuring-zed
{
    // Editor. Only values that differ from Zed's defaults are listed.
    "base_keymap": "VSCode",
    "buffer_font_family": "Liga SFMono Nerd Font",
    "buffer_font_fallbacks": [
        "SFMono Nerd Font",
        "SF Mono",
        "JetBrainsMono Nerd Font",
        "JetBrains Mono",
        "FiraCode Nerd Font",
        "FiraCode NF",
        "Fira Code",
        "Menlo"
    ],
    "buffer_font_size": 12,
    "ui_font_family": ".SystemUIFont",
    "ui_font_size": 16,
    "theme": {
        "mode": "system",
        "light": "Ayu Light",
        "dark": "Ayu Dark"
    },
    "icon_theme": "Zed (Default)",
    "colorize_brackets": true,
    "rounded_selection": false,
    "semantic_tokens": "full",
    "seed_search_query_from_cursor": "selection",
    "sticky_scroll": {
        "enabled": true
    },
    "minimap": {
        "show": "always"
    },
    "soft_wrap": "bounded",
    "wrap_guides": [80],

    // Window
    "use_system_window_tabs": true,
    "confirm_quit": true,

    // Panels
    "project_panel": {
        "dock": "left",
        "sort_order": "unicode"
    },
    "outline_panel": {
        "dock": "right"
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "git_panel": {
        "dock": "left"
    },

    // Agent and edit predictions
    "agent_servers": {},
    "edit_predictions": {
        "provider": "zed"
    },
    "agent": {
        "default_profile": "ask",
        "dock": "right",
        "inline_assistant_model": {
            "provider": "copilot_chat",
            "model": "claude-sonnet-4.5"
        },
        "default_model": {
            "enable_thinking": true,
            "effort": "low",
            "provider": "zed.dev",
            "model": "gpt-5.5"
        }
    },

    // Files
    "file_scan_exclusions": [
        "**/__pycache__",
        "**/.git",
        "**/.venv",
        "**/*.lock",
        "**/node_modules"
    ],

    // Terminal
    "terminal": {
        "font_family": "Liga SFMono Nerd Font",
        "font_fallbacks": [
            "SFMono Nerd Font Medium",
            "SF Mono",
            "JetBrainsMono Nerd Font",
            "JetBrains Mono",
            "FiraCode NF",
            "Fira Code",
            "Menlo"
        ],
        "font_size": 12.5,
        "font_weight": 500,
        "blinking": "on",
        "cursor_shape": "bar",
        "bell": "system",
        "option_as_meta": true,
        "shell": {
            "with_arguments": {
                "program": "/bin/zsh",
                "args": ["-is"]
            }
        },
        "env": {
            "DOTFILES_HISTORY": "private"
        }
    },

    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },

    // Languages. Editor settings above already apply to every language.
    "languages": {
        "Python": {
            "language_servers": ["ruff"],
            "format_on_save": "on",
            "formatter": [
                {
                    "code_action": "source.organizeImports.ruff"
                },
                {
                    "code_action": "source.fixAll.ruff"
                },
                {
                    "language_server": {
                        "name": "ruff"
                    }
                }
            ]
        },
        "JSON": {
            "tab_size": 4
        },
        "JSONC": {
            "tab_size": 4
        }
    },

    "auto_install_extensions": {
        "git-firefly": true,
        "html": true,
        "log": true,
        "markdownlint": true,
        "mermaid": true,
        "toml": true
    }
}
