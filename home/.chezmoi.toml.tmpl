{{- $profileCatalog := include ".chezmoidata/profiles.yaml" | fromYaml -}}
{{- $machineCatalog := include ".chezmoidata/machines.yaml" | fromYaml -}}

{{- $username := .chezmoi.username -}}
{{- $hostname := .chezmoi.hostname -}}
{{- if and (eq .chezmoi.os "darwin") (lookPath "scutil") -}}
{{-     $hostname = output "scutil" "--get" "ComputerName" | trim -}}
{{- end -}}

{{- $hostnameKey := lower $hostname -}}
{{- $machineName := get $machineCatalog.hostname_machines $hostnameKey -}}
{{- range $match := $machineCatalog.hostname_prefix_machines -}}
{{-     if and (not $machineName) (hasPrefix $match.prefix $hostnameKey) -}}
{{-         $machineName = $match.machine -}}
{{-     end -}}
{{- end -}}

{{- $machine := dict -}}
{{- if $machineName -}}
{{-     $machine = get $machineCatalog.machines $machineName -}}
{{- end -}}

{{- $globalDefaults := $machineCatalog.machine_defaults.global -}}
{{- $osDefaults := get $machineCatalog.machine_defaults.by_os .chezmoi.os | default dict -}}
{{- $defaultProfile := get $osDefaults "profile" | default (get $profileCatalog.profile_defaults .chezmoi.os) | default "linux-desktop" -}}
{{- $profileChoices := get $profileCatalog.profile_choices .chezmoi.os | default (list $defaultProfile) -}}
{{- $interactive := stdinIsATTY -}}

{{- $codename := $hostname -}}
{{- $profile := $defaultProfile -}}
{{- $vault := "" -}}
{{- $headless := false -}}
{{- $client := false -}}
{{- $personal := true -}}
{{- $agent := false -}}
{{- $shared := false -}}
{{- $hasSudo := false -}}
{{- $gitName := "" -}}
{{- $gitEmail := "" -}}
{{- $gitSigningKey := "" -}}
{{- $hasProfileData := and (not $machineName) (not (empty (get . "profile"))) -}}

{{- range $source := list $globalDefaults $osDefaults $machine -}}
{{-     if hasKey $source "codename" }}{{ $codename = get $source "codename" }}{{ end -}}
{{-     if hasKey $source "profile" }}{{ $profile = get $source "profile" }}{{ end -}}
{{-     if hasKey $source "vault" }}{{ $vault = get $source "vault" }}{{ end -}}
{{-     if hasKey $source "headless" }}{{ $headless = get $source "headless" }}{{ end -}}
{{-     if hasKey $source "client" }}{{ $client = get $source "client" }}{{ end -}}
{{-     if hasKey $source "personal" }}{{ $personal = get $source "personal" }}{{ end -}}
{{-     if hasKey $source "agent" }}{{ $agent = get $source "agent" }}{{ end -}}
{{-     if hasKey $source "shared" }}{{ $shared = get $source "shared" }}{{ end -}}
{{-     if hasKey $source "hasSudo" }}{{ $hasSudo = get $source "hasSudo" }}{{ end -}}
{{-     if hasKey $source "gitName" }}{{ $gitName = get $source "gitName" }}{{ end -}}
{{-     if hasKey $source "gitEmail" }}{{ $gitEmail = get $source "gitEmail" }}{{ end -}}
{{-     if hasKey $source "gitSigningKey" }}{{ $gitSigningKey = get $source "gitSigningKey" }}{{ end -}}
{{- end -}}

{{- if and (not $machineName) (get . "codename") -}}
{{-     $codename = get . "codename" -}}
{{- end -}}
{{- if $hasProfileData -}}
{{-     $profile = get . "profile" -}}
{{- end -}}

{{- if and (not $machineName) $interactive -}}
{{-     $codename = promptStringOnce . "codename" "codename" $hostname -}}
{{-     $profile = promptChoiceOnce . "profile" "profile" $profileChoices $defaultProfile -}}
{{- else if and (not $machineName) (not $hasProfileData) (eq .chezmoi.os "linux") -}}
{{-     $profile = "linux-minimal" -}}
{{- end -}}

{{- if not (hasKey $profileCatalog.profiles $profile) -}}
{{-     fail (printf "unknown chezmoi profile %q" $profile) -}}
{{- end -}}

{{- $profileSpec := get $profileCatalog.profiles $profile | default dict -}}
{{- $profileDefaults := get $profileSpec "defaults" | default dict -}}
{{- range $source := list $profileDefaults $machine -}}
{{-     if hasKey $source "codename" }}{{ $codename = get $source "codename" }}{{ end -}}
{{-     if hasKey $source "profile" }}{{ $profile = get $source "profile" }}{{ end -}}
{{-     if hasKey $source "vault" }}{{ $vault = get $source "vault" }}{{ end -}}
{{-     if hasKey $source "headless" }}{{ $headless = get $source "headless" }}{{ end -}}
{{-     if hasKey $source "client" }}{{ $client = get $source "client" }}{{ end -}}
{{-     if hasKey $source "personal" }}{{ $personal = get $source "personal" }}{{ end -}}
{{-     if hasKey $source "agent" }}{{ $agent = get $source "agent" }}{{ end -}}
{{-     if hasKey $source "shared" }}{{ $shared = get $source "shared" }}{{ end -}}
{{-     if hasKey $source "hasSudo" }}{{ $hasSudo = get $source "hasSudo" }}{{ end -}}
{{-     if hasKey $source "gitName" }}{{ $gitName = get $source "gitName" }}{{ end -}}
{{-     if hasKey $source "gitEmail" }}{{ $gitEmail = get $source "gitEmail" }}{{ end -}}
{{-     if hasKey $source "gitSigningKey" }}{{ $gitSigningKey = get $source "gitSigningKey" }}{{ end -}}
{{- end -}}

{{- if or
        (env "CODESPACES")
        (env "REMOTE_CONTAINERS_IPC")
        (eq $username "root" "ubuntu" "vagrant" "vscode")
-}}
{{-     $headless = true -}}
{{- else if and (not $machineName) $interactive -}}
{{-     $headless = promptBoolOnce . "headless" "headless" $headless -}}
{{- else if not $machineName -}}
{{-     $headless = true -}}
{{- end -}}

{{- $userOverrides := get $machine "users" | default dict -}}
{{- $userOverride := get $userOverrides $username | default (get $userOverrides "default") | default dict -}}
{{- if hasKey $userOverride "shared" }}{{ $shared = get $userOverride "shared" }}{{ end -}}
{{- if hasKey $userOverride "hasSudo" }}{{ $hasSudo = get $userOverride "hasSudo" }}{{ end -}}

{{- $sourceDir := .chezmoi.workingTree | default (dir .chezmoi.sourceDir) -}}
{{- $scriptPathEntries := list
        "/opt/homebrew/bin"
        "/usr/local/bin"
        "/home/linuxbrew/.linuxbrew/bin"
        (joinPath .chezmoi.homeDir ".local/bin")
-}}
{{- range $pathEntry := splitList ":" (env "PATH") -}}
{{-     if and $pathEntry (not (has $pathEntry $scriptPathEntries)) -}}
{{-         $scriptPathEntries = append $scriptPathEntries $pathEntry -}}
{{-     end -}}
{{- end -}}

umask = 0o022

sourceDir = {{ $sourceDir | quote }}

[data]
    codename = {{ $codename | quote }}
    profile = {{ $profile | quote }}
    personal = {{ $personal }}
    vault = {{ $vault | quote }}
    headless = {{ $headless }}
    client = {{ $client }}
    agent = {{ $agent }}
    shared = {{ $shared }}
    hasSudo = {{ $hasSudo }}
    gitName = {{ $gitName | quote }}
    gitEmail = {{ $gitEmail | quote }}
    gitSigningKey = {{ $gitSigningKey | quote }}

[diff]
    exclude = ["scripts"]

[status]
    exclude = ["scripts"]

[scriptEnv]
    {{ if ne .chezmoi.os "windows" -}}
    PATH = {{ join ":" $scriptPathEntries | quote }}
    {{- end }}

[interpreters.ps1]
    command = "powershell"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]
