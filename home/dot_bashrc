#!/bin/bash

# Bash interactive entry.
#
# This is intentionally boring.  The real setup lives under ~/.config/shell so
# Bash and Zsh share one structure without hiding behavior in startup loops.

dotfiles_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
dotfiles_interactive="$dotfiles_config_home/shell/interactive.sh"
[ -r "$dotfiles_interactive" ] || dotfiles_interactive="$HOME/.config/shell/interactive.sh"

if [[ -r "$dotfiles_interactive" ]]; then
    DOTFILES_SHELL_ROOT="${dotfiles_interactive%/*}"
    export DOTFILES_SHELL_ROOT
    # The entry file supports both XDG and fallback locations, so this path is
    # chosen at runtime.
    # shellcheck disable=SC1091
    # shellcheck source=dot_config/shell/interactive.sh
    . "$dotfiles_interactive" bash "$@"
fi
unset dotfiles_config_home dotfiles_interactive
