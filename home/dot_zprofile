#!/bin/zsh

# Zsh login profile.
#
# Zsh does not read ~/.profile by default.  Point it at the same profile loader
# so Bash and Zsh agree on the session environment.

dotfiles_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
dotfiles_profile="$dotfiles_config_home/shell/profile.sh"
[ -r "$dotfiles_profile" ] || dotfiles_profile="$HOME/.config/shell/profile.sh"

if [[ -r "$dotfiles_profile" ]]; then
    DOTFILES_SHELL_ROOT="${dotfiles_profile%/*}"
    export DOTFILES_SHELL_ROOT
    # shellcheck source=dot_config/shell/profile.sh
    . "$dotfiles_profile"
fi
unset dotfiles_config_home dotfiles_profile
