{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $features "linux" | default dict -}}
{{- $services := get $linux "services" | default dict -}}
{{- $codexRemoteControl := get $services "codex_remote_control" | default dict -}}
{{- $codexRemoteControlEnabled := get $codexRemoteControl "enabled" | default false -}}
{{- if and (eq .chezmoi.os "linux") (not (get $machine "shared")) -}}

#!/usr/bin/env bash

set -euo pipefail

# Unit hash: {{ include "dot_config/systemd/user/codex-remote-control.service.tmpl" | sha256sum }}
unit=codex-remote-control.service
codex_remote_control_enabled={{ if $codexRemoteControlEnabled }}true{{ else }}false{{ end }}

if ! command -v systemctl >/dev/null; then
    echo "Skipping Codex Remote service changes because systemctl is not installed" >&2
    exit 0
fi

if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "Skipping Codex Remote service changes because the user systemd session is unavailable" >&2
    exit 0
fi

systemctl --user daemon-reload

if [[ "$codex_remote_control_enabled" != true ]]; then
    systemctl --user disable --now "$unit" 2>/dev/null || true
    exit 0
fi

# A user service normally stops when the user logs out. Lingering keeps this
# user manager running after logout and starts it during boot.
current_user="$(id -un)"
if [[ "$(loginctl show-user "$current_user" --property=Linger --value)" != yes ]]; then
    sudo loginctl enable-linger "$current_user"
fi

systemctl --user enable "$unit"
# `restart` also starts the unit when it is currently inactive.
systemctl --user restart "$unit"

{{- end -}}
