{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $features "linux" | default dict -}}
{{- $install := get $linux "install" | default dict -}}
{{- $apt := get $install "apt" | default dict -}}
{{- $homebrew := get $install "homebrew" | default dict -}}
{{- $useApt := $apt.enabled -}}
{{- $useHomebrew := $homebrew.enabled -}}
{{- if (and (eq .chezmoi.os "linux") (lookPath "apt-get") (get $machine "hasSudo") (not (get $machine "shared")) (or $useApt $useHomebrew)) -}}

#!/usr/bin/env bash

set -euo pipefail

ulimit -n "$(ulimit -Hn)"

export DEBIAN_FRONTEND=noninteractive

sudo install -d -m 0755 /etc/apt/keyrings /usr/share/keyrings /etc/apt/sources.list.d

packages=(
    ca-certificates
    curl
    lsb-release
)

{{- if $useHomebrew }}
packages+=(
    build-essential
    file
    git
    procps
)
{{- end }}

{{- if (and $useApt $apt.repositories.ibus_bamboo.enabled (eq .chezmoi.osRelease.id "ubuntu")) }}
packages+=(software-properties-common)
{{- end }}

sudo apt-get update
sudo apt-get install -y "${packages[@]}"

{{- end -}}
