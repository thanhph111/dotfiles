{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $features "linux" | default dict -}}
{{- $services := get $linux "services" | default dict -}}
{{- $samba := get $services "samba" | default dict -}}
{{- $sambaEnabled := get $samba "enabled" | default false -}}
{{- $shareName := get $samba "share_name" | default "Shared" -}}
{{- $shareDirectory := get $samba "directory" | default "Shared" -}}
{{- if (and (eq .chezmoi.os "linux") (get $machine "hasSudo") (not (get $machine "shared"))) -}}

#!/usr/bin/env bash

set -euo pipefail

samba_enabled={{ if $sambaEnabled }}true{{ else }}false{{ end }}
samba_user={{ .chezmoi.username | quote }}
share_name={{ $shareName | quote }}
share_path={{ joinPath .chezmoi.homeDir $shareDirectory | quote }}
config_path=/etc/samba/smb.conf
fragment_path=/etc/samba/smb.conf.d/chezmoi.conf
include_line='include = /etc/samba/smb.conf.d/chezmoi.conf'
changed=false

service_exists() {
    [[ "$(sudo systemctl show -p LoadState --value "$1" 2>/dev/null || true)" == loaded ]]
}

set_service() {
    local enabled="$1"
    local unit="$2"

    service_exists "$unit" || return
    if [[ "$enabled" == true ]]; then
        sudo systemctl enable --now "$unit"
    else
        sudo systemctl disable --now "$unit"
    fi
}

if [[ "$samba_enabled" != true ]]; then
    if sudo test -f "$config_path" && sudo grep -Fqx "$include_line" "$config_path"; then
        tmp="$(mktemp)"
        sudo awk -v line="$include_line" '$0 != line' "$config_path" | tee "$tmp" >/dev/null
        sudo install -m 0644 "$tmp" "$config_path"
        rm -f "$tmp"
    fi
    sudo rm -f "$fragment_path"
    if command -v systemctl >/dev/null; then
        set_service false smbd.service
        set_service false nmbd.service
    fi
    exit 0
fi

if [[ "$share_name" == *$'\n'* || "$share_name" == *'['* || "$share_name" == *']'* ]]; then
    printf 'samba setup: invalid share name %q\n' "$share_name" >&2
    exit 1
fi

if ! command -v testparm >/dev/null; then
    echo 'samba setup: Samba is not installed; run the package setup first' >&2
    exit 1
fi

if [[ ! -e "$share_path" ]]; then
    install -d -m 0750 "$share_path"
elif [[ ! -d "$share_path" ]]; then
    printf 'samba setup: share path is not a directory: %s\n' "$share_path" >&2
    exit 1
fi

tmp="$(mktemp)"
cat >"$tmp" <<EOF
[global]
    disable netbios = yes
    map to guest = Never
    server min protocol = SMB2_02

[$share_name]
    path = $share_path
    browseable = yes
    read only = no
    guest ok = no
    valid users = $samba_user
    follow symlinks = no
EOF

if ! sudo test -f "$fragment_path" || ! sudo cmp -s "$tmp" "$fragment_path"; then
    sudo install -D -m 0644 "$tmp" "$fragment_path"
    changed=true
fi
rm -f "$tmp"

if ! sudo test -f "$config_path"; then
    echo "samba setup: missing $config_path after Samba installation" >&2
    exit 1
fi

if ! sudo grep -Fqx "$include_line" "$config_path"; then
    printf '\n%s\n' "$include_line" | sudo tee -a "$config_path" >/dev/null
    changed=true
fi

sudo testparm -s "$config_path" >/dev/null

if ! command -v systemctl >/dev/null; then
    echo 'samba setup: systemctl is not installed' >&2
    exit 1
fi

set_service false nmbd.service
set_service true smbd.service
if [[ "$changed" == true ]]; then
    sudo systemctl reload smbd.service
fi

if ! sudo pdbedit -L 2>/dev/null | cut -d: -f1 | grep -Fqx "$samba_user"; then
    printf 'Samba login is not set up yet. Run: sudo smbpasswd -a %q\n' "$samba_user" >&2
fi

{{- end -}}
