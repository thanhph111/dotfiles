{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $features "linux" | default dict -}}
{{- $network := get $linux "network" | default dict -}}
{{- $ufw := get $network "ufw" | default dict -}}
{{- $ufwRules := get $ufw "rules" | default dict -}}
{{- $ufwEnabled := get $ufw "enabled" | default false -}}
{{- $ufwDefaultIncoming := get $ufw "default_incoming" | default "deny" -}}
{{- $ufwDefaultOutgoing := get $ufw "default_outgoing" | default "allow" -}}
{{- $sshAllowed := eq $ufwDefaultIncoming "allow" -}}
{{- if (and (eq .chezmoi.os "linux") (get $machine "hasSudo") (not (get $machine "shared")) $ufwEnabled) -}}

#!/usr/bin/env bash

set -euo pipefail

default_incoming={{ $ufwDefaultIncoming | quote }}
default_outgoing={{ $ufwDefaultOutgoing | quote }}

enabled_tcp_ports=(
{{- range $ruleName := keys $ufwRules | sortAlpha }}
{{-     $rule := get $ufwRules $ruleName -}}
{{-     $ruleEnabled := get $rule "enabled" | default false -}}
{{-     if $ruleEnabled -}}
{{-         $protocol := get $rule "protocol" | default "tcp" -}}
{{-         if ne $protocol "tcp" -}}
{{-             fail (printf "ufw rule %q uses unsupported protocol %q; only tcp is supported" $ruleName $protocol) -}}
{{-         end -}}
{{-         if not (hasKey $rule "port") -}}
{{-             fail (printf "ufw rule %q is enabled but has no port" $ruleName) -}}
{{-         end -}}
{{-         $port := printf "%v" (get $rule "port") -}}
{{-         if eq $port "22" -}}
{{-             $sshAllowed = true -}}
{{-         end -}}
    {{ $port | quote }}
{{-     end -}}
{{- end }}
)
ssh_policy_allows_ssh={{ if $sshAllowed }}true{{ else }}false{{ end }}

die() {
    printf 'ufw setup: %s\n' "$*" >&2
    exit 1
}

validate_policy() {
    case "$1" in
        allow|deny|reject) ;;
        *) die "$2 must be allow, deny, or reject; got $1" ;;
    esac
}

validate_port() {
    local port="$1"
    local port_number

    [[ $port =~ ^[0-9]+$ ]] || die "TCP port must be a number; got $port"
    port_number=$((10#$port))
    ((port_number >= 1 && port_number <= 65535)) ||
        die "TCP port must be between 1 and 65535; got $port"
}

validate_policy "$default_incoming" default_incoming
validate_policy "$default_outgoing" default_outgoing

for port in "${enabled_tcp_ports[@]}"; do
    validate_port "$port"
done

ssh_local_address=''
if [[ -n "${SSH_CONNECTION:-}" ]]; then
    read -r _ _ ssh_local_address _ <<<"$SSH_CONNECTION"
fi

ssh_is_loopback_tunnel=false
case "$ssh_local_address" in
    127.*|::1|localhost) ssh_is_loopback_tunnel=true ;;
esac

if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}" && "$ssh_policy_allows_ssh" != true && "$ssh_is_loopback_tunnel" != true ]]; then
    if [[ "${DOTFILES_ALLOW_UFW_LOCKOUT:-}" != 1 ]]; then
        die "refusing to reset UFW over direct SSH because resolved UFW rules do not allow TCP port 22; set DOTFILES_ALLOW_UFW_LOCKOUT=1 to override"
    fi
fi

sudo ufw --force reset
sudo ufw default "$default_incoming" incoming
sudo ufw default "$default_outgoing" outgoing

for port in "${enabled_tcp_ports[@]}"; do
    sudo ufw allow "${port}/tcp"
done

sudo ufw --force enable

{{- end -}}
