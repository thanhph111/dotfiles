{{- $packages := includeTemplate "resolved-packages.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $packages "linux" | default dict -}}
{{- $system := get $linux "system" | default dict -}}
{{- if (and (eq .chezmoi.os "linux") (get $machine "hasSudo") (not (get $machine "shared")) $system.sudoers_disable_admin_flag) -}}

#!/usr/bin/env bash

set -euo pipefail

tmp="$(mktemp)"
cat >"$tmp" <<'EOF'
# Disable ~/.sudo_as_admin_successful file
Defaults !admin_flag
EOF

sudo visudo -cf "$tmp"
sudo install -D -m 0440 "$tmp" /etc/sudoers.d/disable-admin-file-in-home
rm -f "$tmp"

{{- end -}}
