{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $features "linux" | default dict -}}
{{- $security := get $linux "security" | default dict -}}
{{- $sudoersDisableAdminFlag := get $security "sudoers_disable_admin_flag" | default dict -}}
{{- $enabled := get $sudoersDisableAdminFlag "enabled" | default false -}}
{{- if (and (eq .chezmoi.os "linux") (get $machine "hasSudo") (not (get $machine "shared")) $enabled) -}}

#!/usr/bin/env bash

set -euo pipefail

tmp="$(mktemp)"
cat >"$tmp" <<'EOF'
# Disable ~/.sudo_as_admin_successful file
Defaults !admin_flag
EOF

sudo visudo -cf "$tmp"
sudo install -D -m 0440 "$tmp" /etc/sudoers.d/disable-admin-file-in-home
rm -f "$tmp"

{{- end -}}
