{{- if (and (eq .chezmoi.os "linux") .hasSudo (not .shared)) -}}

#!/usr/bin/env bash

set -euo pipefail

#: Add the Flathub repository
flatpak remote-add --if-not-exists --user flathub https://flathub.org/repo/flathub.flatpakrepo

#: Install Flatpak apps

xargs flatpak install -y --user flathub <{{ joinPath .chezmoi.sourceDir ".flatpak" (lower .codename) | quote }}

{{- end -}}
