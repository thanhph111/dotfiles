{{- $packages := includeTemplate "resolved-packages.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $packages "linux" | default dict -}}
{{- $flatpak := get $linux "flatpak" | default dict -}}
{{- if (and (eq .chezmoi.os "linux") (get $machine "hasSudo") (not (get $machine "shared")) $flatpak.enabled) -}}

#!/usr/bin/env bash

set -euo pipefail

{{- range $flatpak.manifests }}
# flatpak manifest hash: {{ . }} {{ include (joinPath ".flatpak" .) | sha256sum }}
{{- end }}

flatpak remote-add --if-not-exists --user flathub https://flathub.org/repo/flathub.flatpakrepo

{{- range $flatpak.manifests }}
xargs -r flatpak install -y --user flathub <{{ joinPath $.chezmoi.sourceDir ".flatpak" . | quote }}
{{- end }}

{{- end -}}
