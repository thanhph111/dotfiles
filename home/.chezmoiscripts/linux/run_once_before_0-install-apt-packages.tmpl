#: Cloudflare Warp <<<

#: Reference: https://pkg.cloudflareclient.com/#debian

#: Temporary disable installing Cloudflare Warp, remove `false &&` to enable it
are_all_packages_installed cloudflare-warp || false && {
    #: Setup key
    curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg |
        sudo gpg --yes --dearmor --output /etc/apt/keyrings/cloudflare-warp.gpg

    #: Setup repository
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/cloudflare-warp.gpg] https://pkg.cloudflareclient.com/ ${DIST_CODENAME} main" |
        sudo tee /etc/apt/sources.list.d/cloudflare-warp.list

    #: Install Cloudflare Warp
    sudo aptitude update && sudo aptitude install -y cloudflare-warp
}

