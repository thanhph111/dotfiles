{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $linux := get $features "linux" | default dict -}}
{{- $install := get $linux "install" | default dict -}}
{{- $apt := get $install "apt" | default dict -}}
{{- $services := get $linux "services" | default dict -}}
{{- $samba := get $services "samba" | default dict -}}
{{- if (and (eq .chezmoi.os "linux") (lookPath "apt-get") (get $machine "hasSudo") (not (get $machine "shared")) $apt.enabled) -}}

#!/usr/bin/env bash

set -euo pipefail

# apt package flags: {{ $apt | toJson | sha256sum }}
{{- range $apt.manifests }}
# apt manifest hash: {{ . }} {{ include (joinPath ".apt" .) | sha256sum }}
{{- end }}

export DEBIAN_FRONTEND=noninteractive

packages=()
nvidia_toolkit_packages=()

read_package_manifest() {
    local manifest="$1"

    while IFS= read -r line; do
        line="${line%%#*}"
        [[ -n "${line//[[:space:]]/}" ]] || continue
        read -r -a words <<<"$line"
        packages+=("${words[@]}")
    done <"$manifest"
}

{{- range $apt.manifests }}
read_package_manifest {{ joinPath $.chezmoi.sourceDir ".apt" . | quote }}
{{- end }}

{{- if $apt.repositories.onepassword.enabled }}
if [[ "$(dpkg --print-architecture)" == "amd64" ]]; then
    packages+=(1password 1password-cli)
fi
{{- end }}
{{- if $apt.repositories.google_chrome.enabled }}
if [[ "$(dpkg --print-architecture)" == "amd64" ]]; then
    packages+=(google-chrome-stable)
fi
{{- end }}
{{- if $apt.repositories.vscode.enabled }}
packages+=(code)
{{- end }}
{{- if $apt.repositories.powershell.enabled }}
packages+=(powershell)
{{- end }}
{{- if $apt.repositories.docker.enabled }}
packages+=(docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)
{{- end }}
{{- if $apt.repositories.nvidia_container_toolkit.enabled }}
nvidia_toolkit_version={{ $apt.repositories.nvidia_container_toolkit.package_version | quote }}
if [[ ! "$nvidia_toolkit_version" =~ ^[0-9][0-9A-Za-z.+:~_-]*$ ]]; then
    printf 'Invalid NVIDIA Container Toolkit package version: %s\n' "$nvidia_toolkit_version" >&2
    exit 1
fi

nvidia_toolkit_packages=(
    "nvidia-container-toolkit=${nvidia_toolkit_version}"
    "nvidia-container-toolkit-base=${nvidia_toolkit_version}"
    "libnvidia-container-tools=${nvidia_toolkit_version}"
    "libnvidia-container1=${nvidia_toolkit_version}"
)
{{- end }}
{{- if $apt.repositories.ibus_bamboo.enabled }}
packages+=(ibus ibus-bamboo)
{{- end }}
{{- if $apt.repositories.cloudflare_warp.enabled }}
packages+=(cloudflare-warp)
{{- end }}
{{- if $apt.repositories.cloudflared.enabled }}
packages+=(cloudflared)
{{- end }}
{{- if $apt.repositories.openvpn3.enabled }}
packages+=(openvpn3)
{{- end }}
{{- if (get $samba "enabled" | default false) }}
packages+=(samba)
{{- end }}

sudo apt-get update

if ((${#nvidia_toolkit_packages[@]})); then
    sudo apt-get install -y --allow-downgrades "${nvidia_toolkit_packages[@]}"
fi

if ((${#packages[@]})); then
    sudo apt-get install -y "${packages[@]}"
fi

{{- if $apt.upgrade_on_apply }}
sudo apt-get upgrade -y
{{- end }}

{{- if $apt.autoremove_on_apply }}
sudo apt-get autoremove -y
{{- end }}

{{- if $apt.repositories.docker.enabled }}
if getent group docker >/dev/null; then
    sudo usermod -aG docker "$USER"
fi
{{- end }}

{{- if $apt.repositories.ibus_bamboo.enabled }}
if command -v dconf >/dev/null && command -v gsettings >/dev/null; then
    env DCONF_PROFILE=ibus \
        dconf write /desktop/ibus/general/preload-engines "['BambooUs', 'Bamboo']" &&
        gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('ibus', 'Bamboo')]"
fi
{{- end }}

{{- end -}}
