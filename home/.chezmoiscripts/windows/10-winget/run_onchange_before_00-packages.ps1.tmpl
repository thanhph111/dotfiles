{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $windows := get $features "windows" | default dict -}}
{{- $install := get $windows "install" | default dict -}}
{{- $winget := get $install "winget" | default dict -}}
{{- if (and (eq .chezmoi.os "windows") $winget.enabled) -}}

{{- range $winget.manifests }}
# winget import hash: {{ . }} {{ include (joinPath ".winget" .) | sha256sum }}

$manifest = Join-Path $env:CHEZMOI_SOURCE_DIR '.winget\{{ . }}'

winget import `
    --import-file $manifest `
    --no-upgrade `
    --accept-package-agreements `
    --accept-source-agreements `
    --disable-interactivity
{{- end }}

{{- end -}}
