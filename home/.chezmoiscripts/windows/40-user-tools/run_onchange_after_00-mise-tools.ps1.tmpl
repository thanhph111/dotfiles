{{- $features := includeTemplate "resolved-features.json" . | fromJson -}}
{{- $windows := get $features "windows" | default dict -}}
{{- $tools := get $windows "tools" | default dict -}}
{{- $mise := get $tools "mise" | default dict -}}
{{- if (and (eq .chezmoi.os "windows") $mise.enabled) -}}

# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# mise lock hash: {{ include "dot_config/mise/mise.lock" | sha256sum }}

$mise = Get-Command mise -ErrorAction SilentlyContinue
if ($mise) {
    & $mise.Source install --yes --locked --cd $HOME
}

{{- end -}}
