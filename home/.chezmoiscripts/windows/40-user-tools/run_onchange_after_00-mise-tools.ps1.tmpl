{{- $packages := includeTemplate "resolved-packages.json" . | fromJson -}}
{{- $windows := get $packages "windows" | default dict -}}
{{- $mise := get $windows "mise" | default dict -}}
{{- if (and (eq .chezmoi.os "windows") $mise.enabled) -}}

# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

$mise = Get-Command mise -ErrorAction SilentlyContinue
if ($mise) {
    & $mise.Source install --yes
}

{{- end -}}
