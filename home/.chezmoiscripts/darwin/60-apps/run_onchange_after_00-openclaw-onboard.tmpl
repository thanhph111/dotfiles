{{- $packages := includeTemplate "resolved-packages.json" . | fromJson -}}
{{- $machine := includeTemplate "resolved-machine.json" . | fromJson -}}
{{- $darwin := get $packages "darwin" | default dict -}}
{{- $openclawOnboard := get $darwin "openclaw_onboard" | default dict -}}
{{- if (and (eq .chezmoi.os "darwin") (get $machine "agent") $openclawOnboard.enabled) -}}

#!/usr/bin/env bash

set -euo pipefail

command -v op >/dev/null || exit 0
command -v openclaw >/dev/null || exit 0

if ! launchctl list | grep -q "openclaw"; then
    openclaw onboard --install-daemon
fi

{{- end -}}
