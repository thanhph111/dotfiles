{{- $packages := includeTemplate "resolved-packages.json" . | fromJson -}}
{{- $darwin := get $packages "darwin" | default dict -}}
{{- $mise := get $darwin "mise" | default dict -}}
{{- if (and (eq .chezmoi.os "darwin") $mise.enabled) -}}

#!/usr/bin/env bash

set -euo pipefail

# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

command -v mise >/dev/null || exit 0
mise install --yes

{{- end -}}
