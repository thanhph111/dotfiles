": vim: set fileencoding=utf-8 foldmethod=marker foldlevel=0:
": vim: set colorcolumn=81 nospell:

": This `.vimrc` is intended to be used with the non-plugin flavor of Vim.
": I don't really remember what features it requires, so let's compile Vim with
": most popular features enabled and you will be fine.
": I'm using Kitty terminal and Fira Code Retina Nerd Font and it's awesome.

": Let don't play with GUI
if has('gui_running')
    finish
endif

": Allow to run modelines with 5 top and bottom lines
set modelines=5

": Create a Autocmds holder for all the autocmds
": Reference: https://vi.stackexchange.com/q/9455
augroup MyAutocmdGroup
    autocmd!
augroup END

": Source configuration files
source ~/.vim/config/general.vim
source ~/.vim/config/interface.vim
source ~/.vim/config/statusline.vim
source ~/.vim/config/tabline.vim
source ~/.vim/config/files.vim
source ~/.vim/config/folding.vim
source ~/.vim/config/netrw.vim
source ~/.vim/config/completion.vim
source ~/.vim/config/highlighting.vim
source ~/.vim/config/keybindings.vim
source ~/.vim/config/autocommands.vim

": Source local `.vimrc`
if filereadable("~/.vimrc.local")
    source ~/.vimrc.local
endif
