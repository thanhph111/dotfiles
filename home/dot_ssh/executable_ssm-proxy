#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}

usage() {
    cat <<'EOF'
Usage:
  ssm-proxy INSTANCE_ID PORT

Connect SSH through AWS Systems Manager Session Manager.

The target must already be visible to SSM as Online. This script never starts,
stops, or changes an EC2 instance.
EOF
}

die() {
    printf '%s: %s\n' "$program" "$*" >&2
    exit 1
}

if (($# == 1)) && [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
    usage
    exit 0
fi

(($# == 2)) || {
    usage >&2
    exit 2
}

instance_id=$1
port=$2

[[ $instance_id =~ ^i-([0-9a-fA-F]{8}|[0-9a-fA-F]{17})$ ]] ||
    die "target must be an EC2 instance ID, for example i-1234567890abcdef0"

[[ $port =~ ^[0-9]+$ ]] || die "port must be a number"
port_number=$((10#$port))
((port_number >= 1 && port_number <= 65535)) || die "port must be between 1 and 65535"

command -v aws >/dev/null 2>&1 || die "aws CLI was not found in PATH"

status=$(
    aws ssm describe-instance-information \
        --filters "Key=InstanceIds,Values=$instance_id" \
        --query 'InstanceInformationList[0].PingStatus' \
        --output text
) || die "could not read SSM status for $instance_id"

[[ $status == Online ]] ||
    die "SSM status for $instance_id is ${status:-None}; start the instance separately, then try again"

exec aws ssm start-session \
    --target "$instance_id" \
    --document-name AWS-StartSSHSession \
    --parameters "portNumber=$port_number"
