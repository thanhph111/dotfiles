#: vim: set nospell filetype=sshconfig:

{{- if eq .chezmoi.os "darwin" }}
# UseKeychain is an Apple SSH option. Some macOS machines may use a non-Apple
# ssh binary, so keep this ignore rule before any Host or Include block.
IgnoreUnknown UseKeychain
{{- end }}

# Match 1Password SSH bookmarks with the public keys managed by 1Password.
# The desktop app owns this generated file and removes it when disabled.
Include ~/.ssh/1Password/config

{{- if eq .chezmoi.os "darwin" }}
# OrbStack 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
Include ~/.orbstack/ssh/config
{{- end }}

# Per-project SSH overrides. Projects drop files here; this is just plumbing.
# Placed before the SkyPilot include so project Match/Host blocks win on
# first-match for options like ForwardAgent.
Include ~/.ssh/config.d/*

# Added by SkyPilot for ssh config of all clusters
Include ~/.sky/generated/ssh/*

# SSH to EC2 instance IDs through AWS Systems Manager.
Host i-*
    User ec2-user
    ProxyCommand ~/.ssh/ssm-proxy '%h' '%p'

# SSH to Azure VMs through an Azure Bastion native-client tunnel. The Bastion
# resource group and name are account-specific, so the host blocks live in the
# 1Password "SSH servers" note that becomes ~/.ssh/config.d/1password, not here:
#
#     Host azure-*
#         ProxyCommand ~/.ssh/azure-bastion-proxy <resource-group> <bastion-name> '%h' '%p'
#
# The proxy looks the VM up by name, so %h must be the VM name: add a HostName
# line when the alias differs. Run ~/.ssh/azure-bastion-proxy --help for details.

# General defaults stay last. OpenSSH keeps the first value it sees for most
# options, so earlier host/project blocks must get the first chance to decide.
Host *
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
    {{- if stat (joinPath .chezmoi.homeDir "Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh") }}
    # Secretive SSH agent socket
    IdentityAgent "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
    {{- else if stat (joinPath .chezmoi.homeDir "Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock") }}
    # 1Password SSH agent socket
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    {{- end }}
{{- end }}
