#!/bin/bash
#: vim: set fileencoding=utf-8 colorcolumn=81 nospell:

#: Source common profile configurations
common_profile="$HOME/.config/shell/common_profile"
if [ -f "$common_profile" ] && [ -r "$common_profile" ]; then
    # shellcheck source=dot_config/shell/common_profile
    . "$common_profile"
fi
unset common_profile

#: Disable Bash deprecation warning on macOS
export BASH_SILENCE_DEPRECATION_WARNING=1

#: Source `.bashrc`
# shellcheck source=dot_bashrc.tmpl
[ -n "$BASH_VERSION" ] && [ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"
