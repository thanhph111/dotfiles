#!/usr/bin/env bash

set -euo pipefail

{{- range .files }}
# Brewfile hash: {{ . }} {{ include . | sha256sum }}
{{- end }}

#: Remove soft limit
ulimit -n "$(ulimit -Hn)"

case "$CHEZMOI_OS:$CHEZMOI_ARCH" in
darwin:arm64) HOMEBREW_PREFIX="/opt/homebrew" ;;
darwin:amd64) HOMEBREW_PREFIX="/usr/local" ;;
linux:*) HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew" ;;
*)
    echo "Unsupported Homebrew platform: $CHEZMOI_OS:$CHEZMOI_ARCH" >&2
    exit 1
    ;;
esac

BREW_BIN="$HOMEBREW_PREFIX/bin/brew"

[[ -x "$BREW_BIN" ]] || {
    url=https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
    /bin/bash -c "$(curl -fsSL $url)"
    if [[ -x "$BREW_BIN" ]]; then
        eval "$("$BREW_BIN" shellenv)"
    else
        echo 'Failed to install Homebrew'
        exit 1
    fi
}

brew_supports_tap_trust() {
    "$BREW_BIN" help trust >/dev/null 2>&1
}

trust_brewfile_items() {
    local brewfile="$1"
    local kind
    local name
    local tap

    brew_supports_tap_trust || return 0

    awk '
        /^[[:space:]]*brew[[:space:]]+"/ {
            value=$0
            sub(/^[[:space:]]*brew[[:space:]]+"/, "", value)
            sub(/".*/, "", value)
            part_count=split(value, parts, "/")
            if (part_count == 3 && parts[1] != "homebrew") {
                print "formula " value
            }
        }
        /^[[:space:]]*cask[[:space:]]+"/ {
            value=$0
            sub(/^[[:space:]]*cask[[:space:]]+"/, "", value)
            sub(/".*/, "", value)
            part_count=split(value, parts, "/")
            if (part_count == 3 && parts[1] != "homebrew") {
                print "cask " value
            }
        }
    ' "$brewfile" | while read -r kind name; do
        tap="${name%/*}"
        "$BREW_BIN" tap "$tap" >/dev/null
        "$BREW_BIN" trust "--$kind" "$name" >/dev/null
    done
}

brew_bundle() {
    local brewfile="$1"

    trust_brewfile_items "$brewfile"

    if brew_supports_tap_trust; then
        HOMEBREW_REQUIRE_TAP_TRUST=1 "$BREW_BIN" bundle \
            --verbose \
            --file "$brewfile"
    else
        "$BREW_BIN" bundle \
            --verbose \
            --file "$brewfile"
    fi
}

{{- range .files }}
brew_bundle {{ . | quote }}
{{- end }}
