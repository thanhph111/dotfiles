{{- /*
This template emits one JSON object with the final package settings.

Package settings decide which package managers, service setup scripts, and
system package steps should run. Package lists themselves still live in
the manifest files, such as home/.apt/* and home/.Brewfiles/*.

Keep comments in template comments like this one. The rendered output must
be plain JSON because other templates pipe it through fromJson.
*/ -}}
{{- /*
Use resolved-machine.json as the source of truth for the active machine.

Do not repeat hostname or profile logic here. The machine resolver already
knows how to handle known hosts, unknown hosts, saved local answers, and
headless environments.
*/ -}}
{{- $resolvedMachine := includeTemplate "resolved-machine.json" . | fromJson -}}

{{- /*
Load the three package owners:
- packages.yaml owns the broad defaults for each operating system
- profiles.yaml owns reusable machine shapes
- machines.yaml owns one real host's package exceptions

There is no local package override layer here today. If that is ever
needed, add it as an explicit design change and update the docs at the
same time.
*/ -}}
{{- $machine := get .machines (get $resolvedMachine "machineKey") | default dict -}}
{{- $profile := get .profiles (get $resolvedMachine "profile") | default dict -}}
{{- $packageDefaults := get . "packages" | default dict -}}
{{- $profilePackages := get $profile "packages" | default dict -}}
{{- $machinePackages := get $machine "packages" | default dict -}}

{{- /*
Merge each operating system separately.

The order is:
1. package defaults
2. selected profile package settings
3. matched machine package settings

Later values win. deepCopy protects the shared default maps because
mergeOverwrite changes its first input while building the result.

The template always returns linux, darwin, and windows keys. That keeps
callers simple: they can read their OS block without first checking which
machine rendered the template.
*/ -}}
{{- $linux := mergeOverwrite
    (deepCopy (get $packageDefaults "linux" | default dict))
    (get $profilePackages "linux" | default dict)
    (get $machinePackages "linux" | default dict)
-}}
{{- $darwin := mergeOverwrite
    (deepCopy (get $packageDefaults "darwin" | default dict))
    (get $profilePackages "darwin" | default dict)
    (get $machinePackages "darwin" | default dict)
-}}
{{- $windows := mergeOverwrite
    (deepCopy (get $packageDefaults "windows" | default dict))
    (get $profilePackages "windows" | default dict)
    (get $machinePackages "windows" | default dict)
-}}
{{ dict "linux" $linux "darwin" $darwin "windows" $windows | toJson }}
