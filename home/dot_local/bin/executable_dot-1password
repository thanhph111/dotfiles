#!/usr/bin/env -S usage bash

# ShellCheck cannot read the usage shebang, so name the shell for it.
# shellcheck shell=bash

#USAGE about "Operate 1Password items"
#USAGE cmd "add-recovery-codes" help="Import recovery codes into existing items" {
#USAGE     long_help "Each input file is named after the target 1Password item ID, with one recovery code per line. Blank lines are ignored."
#USAGE     arg "<path>" help="A codes file, or a folder of them"
#USAGE }

set -euo pipefail

program=${0##*/}

redact_code() {
    local code=$1
    local length=${#code}

    if ((length < 6)); then
        printf '[redacted:%d chars]' "$length"
    else
        printf '%s... (%d chars)' "${code:0:2}" "$length"
    fi
}

process_file() {
    local filepath=$1
    local mime filename item_id output title code_count width
    local line index formatted_index preview

    printf "==> Processing '%s'\n" "$filepath"

    [[ -f $filepath ]] || {
        printf '%s: Skipping non-file path: %s\n' "$program" "$filepath" >&2
        return 0
    }

    mime=$(file --mime-type -b -- "$filepath") || {
        printf "%s: Could not read file type for '%s'; skipping\n" "$program" "$filepath" >&2
        return 0
    }

    [[ $mime == text/* ]] || {
        printf '%s: Skipping non-text file: %s\n' "$program" "$filepath" >&2
        return 0
    }

    code_count=$(grep -c '[^[:space:]]' "$filepath" || true)
    ((code_count > 0)) || {
        printf '%s: Skipping empty recovery-code file: %s\n' "$program" "$filepath" >&2
        return 0
    }

    filename=${filepath##*/}
    item_id=${filename%.*}

    output=$(op item get "$item_id" --cache) || {
        printf "%s: Failed to get item '%s'; skipping\n" "$program" "$item_id" >&2
        return 1
    }

    title=$(sed -nr 's/^Title:[[:space:]]+//p' <<<"$output")
    printf "Found item '%s' (%s), adding %d recovery code(s)\n" "$item_id" "$title" "$code_count"

    width=${#code_count}
    index=0
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ [^[:space:]] ]] || continue

        index=$((index + 1))
        formatted_index=$(printf "%0${width}d" "$index")
        preview=$(redact_code "$line")

        if op item edit "$item_id" "Recovery Codes.code ${formatted_index}[password]=$line" >/dev/null; then
            printf '    Added code %s: %s\n' "$formatted_index" "$preview"
        else
            printf '%s: Failed to add code %s: %s\n' "$program" "$formatted_index" "$preview" >&2
            return 1
        fi
    done <"$filepath"
}

case "${1:-}" in
add-recovery-codes) ;;
*)
    echo 'usage: dot-1password add-recovery-codes <path>' >&2
    exit 2
    ;;
esac

for command in file grep op sed; do
    command -v "$command" >/dev/null 2>&1 || {
        printf "%s: '%s' is required\n" "$program" "$command" >&2
        exit 1
    }
done

input_path=${usage_path:-}
files_seen=0
failures=0

if [[ -d $input_path ]]; then
    for filepath in "$input_path"/*; do
        [[ -e $filepath ]] || continue
        files_seen=$((files_seen + 1))
        process_file "$filepath" || failures=$((failures + 1))
        printf '\n'
    done

    ((files_seen > 0)) || printf "%s: No files found in '%s'\n" "$program" "$input_path" >&2
elif [[ -f $input_path ]]; then
    files_seen=1
    process_file "$input_path" || failures=$((failures + 1))
else
    printf "%s: Invalid path: '%s'\n" "$program" "$input_path" >&2
    exit 1
fi

((failures == 0)) || {
    printf '%s: %d file(s) failed\n' "$program" "$failures" >&2
    exit 1
}
