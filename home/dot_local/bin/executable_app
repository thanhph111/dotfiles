-----END CERTIFICATE-----
        """

        download_url = calibre_version = signature = None
        arch = "x86_64"

        # Get tarball info
        print("Downloading tarball signature securely...")
        if version:
            response = request(
                f"https://code.calibre-ebook.com/signatures/calibre-{version}-{arch}.txz.sha512",
                ca_cert=CACERT,
            )
            if response.error:
                raise RuntimeError(response.body)
            signature = response.body
            calibre_version = version
            download_url = (
                f"https://download.calibre-ebook.com/{version}/calibre-{version}-{arch}.txz"
            )
        else:
            response = request(
                f"https://code.calibre-ebook.com/tarball-info/{arch}", ca_cert=CACERT
            )
            if response.error:
                raise RuntimeError(response.body)
            signature, calibre_version = response.body.split("@")
            download_url = f"https://calibre-ebook.com/dist/linux-{arch}"

        if not signature or not calibre_version:
            raise ValueError("Failed to get install file signature, invalid signature returned")
        if isinstance(calibre_version, bytes):
            calibre_version = calibre_version.decode("utf-8")

        # Download tarball
        tarball_file_name = f"calibre-{calibre_version}-{arch}.txz"
        temp_directory = Path(tempfile.gettempdir())
        cache = temp_directory / "calibre-installer-cache"
        cache.mkdir(parents=True, exist_ok=True)

        for x in cache.iterdir():
            if tarball_file_name not in x.name:
                x.unlink()

        tarball_file = cache / tarball_file_name
        signature_matched = check_signature(tarball_file, signature)
        if signature_matched:
            print(f"Using previously downloaded {tarball_file_name}")
        else:
            cached_signature_file = tarball_file.with_suffix(".signature")
            cached_signature = None

            if cached_signature_file.exists():
                with cached_signature_file.open("r") as signature_file:
                    cached_signature = signature_file.read()

            if cached_signature != signature and tarball_file.exists():
                tarball_file.unlink()

            try:
                with cached_signature_file.open("w") as f:
                    f.write(signature)
            except OSError as e:
                if e.errno != errno.EACCES:
                    raise
                print(
                    f"The installer cache directory has incorrect permissions."
                    f" Delete {cache} and try again."
                )
                raise SystemExit(1)

            download(download_url, tarball_file)
            print("Checking downloaded file integrity...")
            signature_matched = check_signature(tarball_file, signature)
            if not signature_matched:
                tarball_file.unlink()
                print(
                    "The downloaded files' signature does not match. Try the download again later."
                )
                raise SystemExit(1)

        # Extract tarball
        if self.install_directory.exists():
            shutil.rmtree(self.install_directory)
        self.install_directory.mkdir(parents=True, exist_ok=True)

        print(f"Extracting files to {self.install_directory}...")
        unarchive(tarball_file, self.install_directory)

        # Create symlink
        print(f"Creating symlink to {DEFAULT_PATH / self.executable}...")
        (DEFAULT_PATH / self.executable).unlink(missing_ok=True)
        (DEFAULT_PATH / self.executable).symlink_to(self.install_directory / self.executable)

    def update(self, version: str | None = None) -> None:
        self.install(version)

    def uninstall(self) -> None:
        import shutil

        shutil.rmtree(self.install_directory)
        (DEFAULT_PATH / self.executable).unlink(missing_ok=True)


APPS = {app_class.__name__.lower(): app_class for app_class in App.__subclasses__()}


def get_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(help="sub-command help", dest="command")
    subparsers.required = True

    install_parser = subparsers.add_parser("install", help="install help")
    install_parser.add_argument("app", choices=APPS.keys(), help="app to install")
    install_parser.add_argument("--version", help="version to install")
    install_parser.set_defaults(func=lambda args: APPS[args.app]().install(args.version))

    update_parser = subparsers.add_parser("update", help="update help")
    update_parser.add_argument("app", choices=APPS.keys(), help="app to update")
    update_parser.add_argument("--version", help="version to update")
    update_parser.set_defaults(func=lambda args: APPS[args.app]().update(args.version))

    uninstall_parser = subparsers.add_parser("uninstall", help="uninstall help")
    uninstall_parser.add_argument("app", choices=APPS.keys(), help="app to uninstall")
    uninstall_parser.set_defaults(func=lambda args: APPS[args.app]().uninstall())

    return parser


def main() -> None:
    parser = get_parser()
    args = parser.parse_args(sys.argv[1:])
    args.func(args)


if __name__ == "__main__":
    main()
