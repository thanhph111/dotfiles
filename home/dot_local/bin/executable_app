#!/usr/bin/env python3

import argparse
import json
import sys
from abc import ABC, abstractmethod
from enum import Enum
from pathlib import Path
from typing import Any, NamedTuple

DEFAULT_PATH = Path.home() / ".local/bin"


class Response(NamedTuple):
    body: str
    headers: dict[str, str]
    status: int
    error: bool = False

    def json(self) -> Any:
        try:
            output = json.loads(self.body)
        except json.JSONDecodeError:
            output = ""
        return output


class Method(Enum):
    GET = "GET"
    POST = "POST"
    PUT = "PUT"
    DELETE = "DELETE"


def request(
    url: str,
    method: Method = Method.GET,
    headers: dict[str, str] | None = None,
    data: dict[str, str] | None = None,
    data_as_json: bool = True,
    params: dict[str, str] | None = None,
    timeout: int = 60,
    max_redirects: int = 5,
    ca_cert: str | None = None,
) -> Response:
    """
    https://github.com/bowmanjd/pysimpleurl
    https://github.com/kovidgoyal/calibre/blob/master/setup/linux-installer.py
    """

    import ssl
    import urllib.error
    import urllib.parse
    import urllib.request

    if not url.lower().startswith("http"):
        raise urllib.error.URLError("Incorrect and possibly insecure protocol in URL")
    request_data = None
    headers = headers or {}
    data = data or {}
    params = params or {}
    headers = {"Accept": "application/json", **headers}

    if method is Method.GET:
        params = {**params, **data}
        data = None

    if params:
        url += "?" + urllib.parse.urlencode(params, doseq=True, safe="/")

    if data:
        if data_as_json:
            request_data = json.dumps(data).encode()
            headers["Content-Type"] = "application/json; charset=UTF-8"
        else:
            request_data = urllib.parse.urlencode(data).encode()

    http_request = urllib.request.Request(
        url=url, data=request_data, headers=headers, method=method.value
    )

    context = ssl.create_default_context()
    context.verify_mode = ssl.CERT_REQUIRED
    if ca_cert:
        context.load_verify_locations(cadata=ca_cert)

    def _fetch(url: str, remaining_redirects: int) -> Response:
        try:
            with urllib.request.urlopen(
                http_request, context=context, timeout=timeout
            ) as http_response:
                response = Response(
                    headers=dict(http_response.headers),
                    status=http_response.status,
                    body=http_response.read().decode(
                        http_response.headers.get_content_charset("utf-8")
                    ),
                )

                if response.status in {301, 302, 303}:
                    if remaining_redirects <= 0:
                        raise ValueError("Too many redirects, giving up")
                    new_url = http_response.getheader("Location", None)
                    if new_url is None:
                        raise ValueError(
                            f"{url} returned a redirect response with no Location header"
                        )
                    return _fetch(new_url, remaining_redirects - 1)

                return response

        except urllib.error.HTTPError as exception:
            return Response(
                body=str(exception.reason),
                headers=dict(exception.headers),
                status=exception.code,
                error=True,
            )

    return _fetch(url, max_redirects)


def download(url: str, file_path: Path) -> None:
    from urllib.request import Request, urlopen

    def show_progress(current: int, total: int, last_percent: float = 0) -> float:
        percent = current / total
        if percent - last_percent > 0.05:
            print(f"Downloaded {percent:.0%}")
            return percent
        return last_percent

    print(f"Downloading {file_path.name}")
    offset = file_path.stat().st_size if file_path.exists() else 0
    headers = {}
    mode = "wb"

    # Get content length
    with urlopen(Request(url)) as response:
        content_length = int(response.getheader("Content-Length", "0"))
        if content_length == 0:
            raise ValueError("Failed to retrieve Content-Length")

    # Handle partial downloads
    if 0 < offset < content_length:
        headers["Range"] = f"bytes={offset}-"
        mode = "ab"
    else:
        offset = 0

    # Download file
    last_percent = 0
    with urlopen(Request(url, headers=headers)) as response:
        total_size = int(response.getheader("Content-Length", "0"))
        with file_path.open(mode) as f:
            bytes_read = offset
            while chunk := response.read(8192):
                f.write(chunk)
                bytes_read += len(chunk)
                last_percent = show_progress(bytes_read, total_size, last_percent)

    # Verify download
    if file_path.stat().st_size < total_size:
        file_path.unlink()
        raise RuntimeError("Download incomplete, please try again")

    print(f"Downloaded {file_path.stat().st_size} bytes")


def unarchive(file_path: Path, destination: Path) -> None:
    import shutil

    print(f"Unarchiving {file_path} to {destination}")
    shutil.unpack_archive(file_path, destination)


def check_signature(file_path: Path, signature: str) -> bool | None:
    import hashlib

    if not file_path.exists():
        return None
    with file_path.open("rb") as file:
        raw = file.read()
    hasher = hashlib.sha512()
    hasher.update(raw)
    return hasher.hexdigest() == signature


class Downloader(ABC):
    @abstractmethod
    def download(self, file_pattern: str, output_file: Path, version: str | None = None) -> None:
        pass


class GitHub(Downloader):
    def __init__(self, owner: str, repo: str) -> None:
        self.owner = owner
        self.repo = repo
        self.api_url = f"https://api.github.com/repos/{self.owner}/{self.repo}/releases"
        self.download_url = f"https://github.com/{self.owner}/{self.repo}/releases/download"

    def download(self, file_pattern: str, output_file: Path, version: str | None = None) -> None:
        import re

        version = version or "latest"
        response = request(f"{self.api_url}/{version}")
        if response.error:
            raise RuntimeError(response.body)

        version = response.json()["tag_name"]
        browser_download_urls: list[str] = [
            asset["browser_download_url"] for asset in response.json()["assets"]
        ]

        browser_download_url = next(
            (
                url
                for url in browser_download_urls
                if re.search(file_pattern, url.removeprefix(f"{self.download_url}/{version}/"))
            ),
            None,
        )
        if not browser_download_url:
            raise RuntimeError(f"Could not find {file_pattern} in {browser_download_urls}")
        download(browser_download_url, output_file)


class App(ABC):
    @abstractmethod
    def install(self, version: str | None = None) -> None:
        pass

    @abstractmethod
    def update(self, version: str | None = None) -> None:
        pass

    @abstractmethod
    def uninstall(self) -> None:
        pass


class WezTerm(App):
    def __init__(
        self, executable: str | None = None, install_directory: Path | None = None
    ) -> None:
        self.executable = executable or "wezterm"
        self.install_directory = install_directory or Path.home() / ".local/bin"
        self.executable_path = self.install_directory / self.executable

    def install(self, version: str | None = None) -> None:
        github = GitHub("wez", "wezterm")
        if version == "nightly":
            download(
                (f"{github.download_url}/nightly/WezTerm-nightly-Ubuntu18.04.AppImage"),
                self.executable_path,
            )
        else:
            github.download(".AppImage$", self.executable_path, version)
        self.executable_path.chmod(0o755)

    def update(self, version: str | None = None) -> None:
        self.install(version)

    def uninstall(self) -> None:
        self.executable_path.unlink()


class Kitty(App):
    def __init__(
        self, executable: str | None = None, install_directory: Path | None = None
    ) -> None:
        self.executable = executable or "kitty"
        self.install_directory = install_directory or Path.home() / ".local/apps/kitty"

    def install(self, version: str | None = None) -> None:
        architecture = "x86_64"
        github = GitHub("kovidgoyal", "kitty")
        if version == "nightly":
            tag = version = "nightly"
        else:
            latest_version = request("https://sw.kovidgoyal.net/kitty/current-version.txt")
            if latest_version.error:
                raise RuntimeError(latest_version.body)
            tag = "v" + (version := latest_version.body)

        archive_file_name = f"kitty-{version}-{architecture}.txz"
        archive_file = self.install_directory.parent / archive_file_name
        self.install_directory.parent.mkdir(parents=True, exist_ok=True)
        download(f"{github.download_url}/{tag}/{archive_file_name}", archive_file)

        unarchive(archive_file, self.install_directory)
        archive_file.unlink()

        (DEFAULT_PATH / self.executable).unlink(missing_ok=True)
        (DEFAULT_PATH / self.executable).symlink_to(self.install_directory / "bin/kitty")

        application_directory = Path.home() / ".local/share/applications"
        application_directory.mkdir(parents=True, exist_ok=True)
        install_share_directory = self.install_directory / "share"
        for desktop_file_name in {"kitty.desktop", "kitty-open.desktop"}:
            exec_file = self.install_directory / "bin/kitty"
            icon_file = install_share_directory / "icons/hicolor/256x256/apps/kitty.png"
            (application_directory / desktop_file_name).write_text(
                (install_share_directory / "applications" / desktop_file_name)
                .read_text()
                .replace("Exec=kitty", f"Exec={exec_file}")
                .replace("Icon=kitty", f"Icon={icon_file}")
            )

    def update(self, version: str | None = None) -> None:
        self.install(version)

    def uninstall(self) -> None:
        import shutil

        (DEFAULT_PATH / self.executable).unlink()
        shutil.rmtree(self.install_directory)
        if not list(self.install_directory.parent.iterdir()):
            self.install_directory.parent.rmdir()

        (Path.home() / ".local/share/applications/kitty.desktop").unlink()
        (Path.home() / ".local/share/applications/kitty-open.desktop").unlink()


class Zap(App):
    def __init__(
        self, executable: str | None = None, install_directory: Path | None = None
    ) -> None:
        self.executable = executable or "zap"
        self.install_directory = install_directory or Path.home() / ".local/bin"
        self.executable_path = self.install_directory / self.executable

    def install(self, version: str | None = None) -> None:
        github = GitHub("srevinsaju", "zap")
        github.download("^zap-amd64$", self.executable_path, version)
        self.executable_path.chmod(0o755)

    def update(self, version: str | None = None) -> None:
        self.install(version)

    def uninstall(self) -> None:
        self.executable_path.unlink()


class Calibre(App):
    def __init__(
        self, executable: str | None = None, install_directory: Path | None = None
    ) -> None:
        self.executable = executable or "calibre-server"
        self.install_directory = (
            install_directory and Path(install_directory).expanduser().resolve()
        ) or Path.home() / ".local/apps/calibre"

    def install(self, version: str | None = None) -> None:
        import errno
        import shutil
        import tempfile

        CACERT = """\
